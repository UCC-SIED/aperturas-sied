/.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base local
prisma/*.db
prisma/*.db-journal
migracion/input/
migracion/reporte-migracion.md
prisma/test.db

# el ejemplo sí se versiona (no tiene credenciales)
!.env.example

# impeccable: consentimiento y config local del hook
.impeccable/config.local.json

# Scratch del ejecutor de planes por subagentes
.superpowers/
