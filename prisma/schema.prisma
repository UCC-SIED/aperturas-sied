datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Unidad {
  id       String    @id // "posgrado" | "educacion"
  nombre   String
  carreras Carrera[]
  periodos Periodo[]
  usuarios Usuario[]
}

model Carrera {
  id                Int               @id @default(autoincrement())
  nombre            String
  unidadId          String
  unidad            Unidad            @relation(fields: [unidadId], references: [id])
  planItems         PlanItem[]
  cohortes          Cohorte[]
  usuarios          UsuarioCarrera[]
  avisosDescartados AvisoDescartado[]

  @@unique([unidadId, nombre])
}

/// Quién entra al sistema. El rol define qué puede hacer:
/// sied = todo · director = planifica sus carreras · unidad = planifica
/// todas las carreras de su unidad académica · consulta = sólo mira.
model Usuario {
  id                   Int                @id @default(autoincrement())
  email                String             @unique
  nombre               String
  rol                  String             @default("consulta")
  activo               Boolean            @default(true)
  /// Hash con sal (scrypt), nunca la contraseña en texto plano. Null hasta
  /// que administración le defina una.
  passwordHash         String?
  /// Mientras esté en true, la persona no puede usar el sistema hasta elegir
  /// una contraseña propia. Arranca en true porque la provisoria del alta la
  /// conoce administración: tiene que dejar de servir en cuanto entre.
  debeElegirContrasena Boolean            @default(true)
  /// Sólo para rol "unidad": qué unidad académica planifica entera.
  unidadId             String?
  unidad               Unidad?            @relation(fields: [unidadId], references: [id])
  carreras             UsuarioCarrera[]
  cambios              Cambio[]
  pedidosContrasena    PedidoContrasena[]
}

/// Un pedido de "no puedo entrar", que el equipo SIED resuelve a mano desde
/// /admin. No hay token ni link: la contraseña la fija una persona y se la
/// comunica por fuera del sistema, porque el remitente de prueba de Resend
/// sólo entrega a la casilla del SIED.
model PedidoContrasena {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creado    DateTime  @default(now())
  /// Null mientras está pendiente. Se sella al fijar la contraseña o al descartarlo.
  resuelto  DateTime?

  @@index([usuarioId])
}

model UsuarioCarrera {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  carreraId Int
  carrera   Carrera @relation(fields: [carreraId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, carreraId])
}

/// Bitácora: el orden de apertura cambia seguido y hay que poder reconstruir quién pidió qué.
model Cambio {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  usuarioId   Int?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  accion      String // agrego_apertura | quito_apertura | movio_apertura | cambio_estado
  detalle     String
  asignaturaCodigo String?
  carreraId   Int?
}

model Asignatura {
  codigo              String    @id
  nombre              String
  catedra             String?
  cargaHoraria        Int?
  asesor              String?
  estado              String    @default("sin_novedad")
  /// Notas del seguimiento: por qué está trabada, qué falta, con quién se habló.
  observaciones       String?
  /// Cuándo se tocó el estado por última vez, para detectar seguimientos viejos.
  estadoDesde         DateTime?
  /// El seminario del plan que esta variante ayuda a cubrir. Null en las
  /// asignaturas comunes. Una variante no tiene PlanItem propio: pertenece al
  /// plan a través de su principal, y por eso no engorda el total del panel.
  principalCodigo     String?
  /// onDelete: SetNull y no Cascade — borrar el seminario del plan no puede
  /// llevarse puesta la producción ya cargada de sus variantes.
  principal           Asignatura?  @relation("Variantes", fields: [principalCodigo], references: [codigo], onDelete: SetNull, onUpdate: Cascade)
  variantes           Asignatura[] @relation("Variantes")
  /// Cuántas variantes hacen falta para dar por cubierto este lugar del plan.
  /// Sólo significa algo en un principal, y depende de la carga horaria de
  /// cada seminario: a veces alcanza con uno, a veces hacen falta los tres.
  variantesRequeridas Int       @default(1)
  docentes            AsignaturaDocente[]
  planItems           PlanItem[]
  aperturas           Apertura[]

  @@index([principalCodigo])
}

/// Una asignatura puede tener más de un docente a cargo; cada uno es su
/// propio registro, no texto libre separado por "/".
model AsignaturaDocente {
  id               Int        @id @default(autoincrement())
  asignaturaCodigo String
  asignatura       Asignatura @relation(fields: [asignaturaCodigo], references: [codigo], onDelete: Cascade)
  nombre           String
  orden            Int        @default(0)

  @@unique([asignaturaCodigo, nombre])
}

model PlanItem {
  id               Int        @id @default(autoincrement())
  carreraId        Int
  carrera          Carrera    @relation(fields: [carreraId], references: [id])
  asignaturaCodigo String
  asignatura       Asignatura @relation(fields: [asignaturaCodigo], references: [codigo])
  orden            Int?

  @@unique([carreraId, asignaturaCodigo])
}

model Cohorte {
  id        Int               @id @default(autoincrement())
  nombre    String
  carreraId Int
  carrera   Carrera           @relation(fields: [carreraId], references: [id])
  aperturas AperturaCohorte[]

  @@unique([carreraId, nombre])
}

/// Calendario del período. En Educación sale de la hoja de períodos
/// (Bimestre A, Cuatrimestral A, ...); en Posgrado, de la columna PERIODO.
/// Las aperturas heredan estas fechas salvo excepción propia.
model Periodo {
  id                  Int        @id @default(autoincrement())
  nombre              String
  tipo                String // mensual | bimestral | cuatrimestral
  unidadId            String
  unidad              Unidad     @relation(fields: [unidadId], references: [id])
  mes                 String?
  inicioCursado       DateTime
  aperturaInscripcion DateTime?
  cierreInscripcion   DateTime?
  finCursado          DateTime?
  aperturaAfi         DateTime?
  cierreAfi           DateTime?
  cierreAsignatura    DateTime?
  actas               DateTime?
  aperturas           Apertura[]

  @@unique([unidadId, nombre])
}

model Apertura {
  id                  Int               @id @default(autoincrement())
  asignaturaCodigo    String
  asignatura          Asignatura        @relation(fields: [asignaturaCodigo], references: [codigo])
  periodoId           Int
  periodo             Periodo           @relation(fields: [periodoId], references: [id])
  inicioCursado       DateTime?
  aperturaInscripcion DateTime?
  cierreInscripcion   DateTime?
  finCursado          DateTime?
  aperturaAfi         DateTime?
  cierreAfi           DateTime?
  cierreAsignatura    DateTime?
  actas               DateTime?
  cohortes            AperturaCohorte[]
  docentesTutor       AperturaDocente[]
  avisosDescartados   AvisoDescartado[]

  @@unique([asignaturaCodigo, periodoId])
}

/// Un director cerró el aviso de "podés sumarte a esta transversal" sin
/// sumar su cohorte — no hay que volver a mostrárselo para esa apertura.
model AvisoDescartado {
  id         Int      @id @default(autoincrement())
  carreraId  Int
  carrera    Carrera  @relation(fields: [carreraId], references: [id], onDelete: Cascade)
  aperturaId Int
  apertura   Apertura @relation(fields: [aperturaId], references: [id], onDelete: Cascade)

  @@unique([carreraId, aperturaId])
}

/// El tutor que acompaña esta apertura puntual — puede cambiar de una
/// apertura a otra de la misma asignatura (distinto de quien la produjo,
/// eso vive en Asignatura.docentes).
model AperturaDocente {
  id         Int      @id @default(autoincrement())
  aperturaId Int
  apertura   Apertura @relation(fields: [aperturaId], references: [id], onDelete: Cascade)
  nombre     String
  orden      Int      @default(0)

  @@unique([aperturaId, nombre])
}

model AperturaCohorte {
  id                  Int      @id @default(autoincrement())
  aperturaId          Int
  apertura            Apertura @relation(fields: [aperturaId], references: [id])
  cohorteId           Int
  cohorte             Cohorte  @relation(fields: [cohorteId], references: [id])
  cursaEnEstaApertura Boolean  @default(true)

  @@unique([aperturaId, cohorteId])
}
