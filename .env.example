# Copiar a .env y completar.

# --- Desarrollo local (SQLite, no requiere nada instalado)
DATABASE_URL="file:./dev.db"

# --- Producción (Supabase). Antes de usar: npm run db:nube
# Connection pooling, puerto 6543 — la que usa la app
# DATABASE_URL="postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa, puerto 5432 — la que usan las migraciones
# DIRECT_URL="postgresql://postgres.xxxx:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Ingreso con Google (ver README). Si faltan, se usa el selector de usuarios.
# AUTH_GOOGLE_ID="...apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="..."
# AUTH_SECRET="generar con: npx auth secret"
# AUTH_URL="https://aperturas-sied.vercel.app"

# --- Clave de acceso al sitio. Sólo hace falta mientras Google no esté configurado.
# ACCESO_USUARIO="sied"
# ACCESO_CLAVE="una-clave-larga"
